<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--  For Display over other apps  -->
<!--    "Display over other apps" lets your app show overlays (like chat heads or floating windows).
        "Full-screen notifications" is required for your app to show full-screen intents (like alarms or incoming calls). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" /> <!-- If I disable SYSTEM_ALERT_WINDOW permission => then not show Display over others apps permission in settings => NOT SHOW REFLECTION SCREEN AT ALL-->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service permission (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--    CHECK WHICH PERMISSION REQUIRED & REMOVE UNNECESSARY ONE-->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:name=".LockInApp"
        android:theme="@style/Theme.App.Starting">

<!--        we must tell Android not to restart the screen when you rotate the phone.
If we don't do this, rotating the phone will destroy your ViewModel and reset the timer-->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.roll_call.TaskRollCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.LockIn"
            tools:targetApi="27" />

        <activity
            android:name=".presentation.task_status.TaskStatusActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            tools:targetApi="27"
            android:theme="@style/Theme.LockIn"
            />

        <activity
            android:name=".presentation.task_distracted_reflection.TaskReflectionActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            tools:targetApi="27"
            android:theme="@style/Theme.LockIn"
            />

        <receiver
            android:name=".system.receiver.TaskStartReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".system.deviceadmin.LockInDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".system.receiver.DailyReminderReceiver" android:exported="false" />

        <receiver android:name=".system.receiver.NightlyReportReceiver" android:exported="false" />

        <receiver android:name=".system.receiver.TaskPrepReceiver" android:exported="false" />
        <receiver android:name=".system.receiver.RollCallTimeoutReceiver" android:exported="false" />
        <receiver android:name=".system.receiver.NotificationDismissReceiver" android:exported="false" />
        <receiver android:name=".system.receiver.TaskReadyReceiver" android:exported="false" />

        <service
            android:name=".system.service.TaskExecutionService"
            android:exported="false"
            android:enabled="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="It is used to run the non-swipeable, ongoing notification of the task that user set in the background, " />
        </service>

    </application>

</manifest>